{
  "name": "chatly/chatly-php",
  "description": "Official PHP SDK for Chatly — REST client, webhook signature verification and widget identity hashing. Zero runtime dependencies (ext-curl + ext-json only).",
  "type": "library",
  "license": "MIT",
  "homepage": "https://chatlychat.com",
  "keywords": [
    "chatly",
    "live chat",
    "livechat",
    "chat",
    "messaging",
    "support",
    "helpdesk",
    "webhooks",
    "sdk"
  ],
  "authors": [
    {
      "name": "Chatly",
      "homepage": "https://chatlychat.com"
    }
  ],
  "support": {
    "docs": "https://chatlychat.com/docs",
    "issues": "https://github.com/chatlychat/chatly/issues"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "suggest": {
    "psr/http-client": "Route requests through an existing PSR-18 client with Chatly\\Psr18Transport. Optional: the SDK ships its own curl transport and needs no PSR packages."
  },
  "autoload": {
    "psr-4": {
      "Chatly\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Chatly\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:nodeps": "php tests/run.php"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
